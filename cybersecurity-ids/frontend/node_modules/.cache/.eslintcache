iction IA sur vos données</li>\n                    <li>• Historique d'analyse personnel</li>\n                    <li>• Gestion de profil et sécurité</li>\n                </ul>\n                <div style={{ display: 'flex', justifyContent: 'center' }}>\n                    <button onClick={() => history.push('/login')} style={{ background: '#cc2936', color: 'white', border: 'none', borderRadius: 8, padding: '14px 36px', fontWeight: 600, fontSize: '1.1rem', cursor: 'pointer', boxShadow: '0 2px 8px rgba(204,41,54,0.08)' }}>\n                        Se connecter\n                    </button>\n                </div>\n            </div>\n        </div>\n    );\n};\n\nexport default Home;","C:\\Users\\dachr\\p2m\\cybersecurity-ids\\frontend\\src\\components\\Navigation.tsx",[],"C:\\Users\\dachr\\p2m\\cybersecurity-ids\\frontend\\src\\services\\api.ts",[],"C:\\Users\\dachr\\p2m\\cybersecurity-ids\\frontend\\src\\components\\Dashboard.tsx",[],["61","62"],"C:\\Users\\dachr\\p2m\\cybersecurity-ids\\frontend\\src\\pages\\ThreatMap.tsx",[],"C:\\Users\\dachr\\p2m\\cybersecurity-ids\\frontend\\src\\pages\\Settings.tsx",[],"C:\\Users\\dachr\\p2m\\cybersecurity-ids\\frontend\\src\\pages\\Monitoring.tsx",[],"C:\\Users\\dachr\\p2m\\cybersecurity-ids\\frontend\\src\\pages\\AlertHistory.tsx",["63"],"C:\\Users\\dachr\\p2m\\cybersecurity-ids\\frontend\\src\\pages\\Login.tsx",[],"C:\\Users\\dachr\\p2m\\cybersecurity-ids\\frontend\\src\\pages\\Signup.tsx",[],"C:\\Users\\dachr\\p2m\\cybersecurity-ids\\frontend\\src\\services\\auth.ts",[],{"ruleId":"64","replacedBy":"65"},{"ruleId":"66","replacedBy":"67"},{"ruleId":"68","severity":1,"message":"69","line":3,"column":8,"nodeType":"70","messageId":"71","endLine":3,"endColumn":17},{"ruleId":"68","severity":1,"message":"72","line":8,"column":11,"nodeType":"70","messageId":"71","endLine":8,"endColumn":19},{"ruleId":"64","replacedBy":"73"},{"ruleId":"66","replacedBy":"74"},{"ruleId":"75","severity":1,"message":"76","line":65,"column":6,"nodeTyp