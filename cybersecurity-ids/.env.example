# Cybersecurity IDS Environment Configuration

# ========== Backend Configuration ==========

# JWT Configuration
JWT_SECRET_KEY=your-secure-random-key-here-min-32-chars

# Server
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_RELOAD=true

# Database
DATABASE_URL=sqlite:///./cybersecurity_ids.db

# Email Notifications
NOTIFICATION_EMAIL_ENABLED=false
NOTIFICATION_EMAIL_SENDER=admin@cybersecurity-ids.local
NOTIFICATION_EMAIL_SMTP_SERVER=smtp.gmail.com
NOTIFICATION_EMAIL_SMTP_PORT=587

# Telegram Notifications
NOTIFICATION_TELEGRAM_ENABLED=false
NOTIFICATION_TELEGRAM_BOT_TOKEN=your-telegram-bot-token

# ML Model
ML_MODEL_PATH=models/detector_model.pkl
ML_MODEL_SENSITIVITY=0.5
ML_CRITICAL_THRESHOLD=0.7
ML_WARNING_THRESHOLD=0.5

# GeoIP Configuration
GEOIP_DATABASE_PATH=databases/GeoLite2-City.mmdb

# ========== Frontend Configuration ==========

# React App
REACT_APP_API_URL=http://localhost:8000
REACT_APP_WS_URL=ws://localhost:8000

# Feature Flags
REACT_APP_ENABLE_WEBSOCKET=true
REACT_APP_ENABLE_EXPORT=true
REACT_APP_ENABLE_GEOLOCATION=true

# ========== Development ==========

# Set to 'development' for local testing, 'production' for deployment
NODE_ENV=development
